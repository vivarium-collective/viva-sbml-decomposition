{"ensemble_scaling": "<div id=\"viva_EnsembleScaling\" style=\"width:100%;height:420px\"></div><script src=\"https://cdn.plot.ly/plotly-2.27.0.min.js\"></script><script>Plotly.newPlot(\"viva_EnsembleScaling\",[{\"type\": \"bar\", \"x\": [\"serial\", \"parallel (ray)\"], \"y\": [1.189, 0.158], \"marker\": {\"color\": [\"#94a3b8\", \"#db2777\"]}, \"text\": [\"1.189 s\", \"0.158 s\"], \"textposition\": \"outside\", \"hovertemplate\": \"%{x}: %{y:.3f} s<extra></extra>\"}],{\"title\": {\"text\": \"Ensemble scaling: Ray beats the GIL<br><span style='font-size:12px;color:#64748b'>8 independent instances, serial vs parallel</span>\", \"x\": 0.02, \"xanchor\": \"left\", \"font\": {\"size\": 17}}, \"margin\": {\"l\": 70, \"r\": 25, \"t\": 80, \"b\": 100}, \"plot_bgcolor\": \"rgba(0,0,0,0)\", \"paper_bgcolor\": \"rgba(0,0,0,0)\", \"font\": {\"color\": \"#64748b\"}, \"yaxis\": {\"title\": {\"text\": \"wall-clock (s)\"}, \"gridcolor\": \"rgba(148,163,184,0.22)\", \"zeroline\": false, \"range\": [0, 1.4268]}, \"xaxis\": {\"gridcolor\": \"rgba(0,0,0,0)\"}, \"showlegend\": false, \"annotations\": [{\"xref\": \"paper\", \"yref\": \"paper\", \"x\": 0.97, \"y\": 0.9, \"xanchor\": \"right\", \"showarrow\": false, \"text\": \"<b>7.52x</b>\", \"font\": {\"size\": 44, \"color\": \"#db2777\"}}, {\"xref\": \"paper\", \"yref\": \"paper\", \"x\": 0.97, \"y\": 0.78, \"xanchor\": \"right\", \"showarrow\": false, \"text\": \"on 16 cores, 8 instances\", \"font\": {\"size\": 13}}, {\"xref\": \"paper\", \"yref\": \"paper\", \"x\": 0, \"y\": -0.2, \"xanchor\": \"left\", \"yanchor\": \"top\", \"text\": \"GIL note: libroadrunner does not release the GIL; ThreadPool(8)=0.99x\", \"showarrow\": false, \"font\": {\"size\": 11, \"color\": \"#64748b\"}}]}, {responsive:true, displayModeBar:false});</script>", "runtime_comparison": "<div id=\"viva_RuntimeComparison\" style=\"width:100%;height:420px\"></div><script src=\"https://cdn.plot.ly/plotly-2.27.0.min.js\"></script><script>Plotly.newPlot(\"viva_RuntimeComparison\",[{\"type\": \"bar\", \"x\": [\"SBML in<br>Tellurium\", \"Mechanical split<br>(additive)\", \"Biological<br>modular seam\", \"Fully native<br>PBG\", \"Ensemble<br>(Ray)\", \"Cross-engine<br>coupling\"], \"y\": [0.32558692543479895, 0.1070475270692257, 0.05, 0.02080837543234802, null, 0.013941529244608909], \"text\": [\"32.6%<br>0.08 s total\", \"10.7%<br>1.27 s total\", \"5.0%<br>total n/a\", \"2.1%<br>0.32 s total\", \"not recorded\", \"1.4%<br>31.90 s total\"], \"textposition\": \"outside\", \"cliponaxis\": false, \"marker\": {\"color\": [\"#2563eb\", \"#d97706\", \"#7c3aed\", \"#059669\", \"#db2777\", \"#0891b2\"]}, \"customdata\": [\"SBML in<br>Tellurium\", \"Mechanical split<br>(additive)\", \"Biological<br>modular seam\", \"Fully native<br>PBG\", \"Ensemble<br>(Ray)\", \"Cross-engine<br>coupling\"], \"hovertemplate\": \"%{customdata}<br>framework share: %{y:.1%}<extra></extra>\"}],{\"title\": {\"text\": \"Framework overhead share by study<br><span style='font-size:12px;color:#64748b'>share of wall-clock spent in the framework (not process compute)</span>\", \"x\": 0.02, \"xanchor\": \"left\", \"font\": {\"size\": 17}}, \"margin\": {\"l\": 70, \"r\": 25, \"t\": 80, \"b\": 110}, \"plot_bgcolor\": \"rgba(0,0,0,0)\", \"paper_bgcolor\": \"rgba(0,0,0,0)\", \"font\": {\"color\": \"#64748b\"}, \"yaxis\": {\"title\": {\"text\": \"overhead fraction\"}, \"gridcolor\": \"rgba(148,163,184,0.22)\", \"zeroline\": false, \"tickformat\": \".0%\", \"range\": [0, 0.4232630030652386]}, \"xaxis\": {\"gridcolor\": \"rgba(0,0,0,0)\"}, \"showlegend\": false, \"annotations\": [{\"xref\": \"paper\", \"yref\": \"paper\", \"x\": 0, \"y\": -0.3, \"xanchor\": \"left\", \"yanchor\": \"top\", \"text\": \"framework SHARE of wall-clock (Composite.timing_summary); highest for the CHEAP monolith, NOT the decomposition cost.\", \"showarrow\": false, \"font\": {\"size\": 11, \"color\": \"#64748b\"}}]}, {responsive:true, displayModeBar:false});</script>", "multirate_scaling": "<div id=\"viva_MultirateScaling\" style=\"width:100%;height:420px\"></div><script src=\"https://cdn.plot.ly/plotly-2.27.0.min.js\"></script><script>Plotly.newPlot(\"viva_MultirateScaling\",[{\"type\": \"scatter\", \"mode\": \"lines+markers\", \"name\": \"scan (stock, O(P\\u00b2))\", \"x\": [4, 16, 64, 128, 256], \"y\": [0.00816, 0.04679, 0.41929, 1.5551, 6.59791], \"line\": {\"color\": \"#94a3b8\", \"width\": 3}, \"marker\": {\"size\": 8}, \"hovertemplate\": \"N=%{x}<br>scan %{y:.3f} s<extra></extra>\"}, {\"type\": \"scatter\", \"mode\": \"lines+markers\", \"name\": \"heap (#270, O(P\\u00b7logP))\", \"x\": [4, 16, 64, 128, 256], \"y\": [0.00834, 0.04917, 0.37145, 1.27974, 4.01931], \"line\": {\"color\": \"#2563eb\", \"width\": 3}, \"marker\": {\"size\": 8}, \"hovertemplate\": \"N=%{x}<br>heap %{y:.3f} s<extra></extra>\"}, {\"type\": \"scatter\", \"mode\": \"lines+markers\", \"name\": \"speedup (scan/heap)\", \"x\": [4, 16, 64, 128, 256], \"y\": [0.979, 0.952, 1.129, 1.215, 1.642], \"yaxis\": \"y2\", \"line\": {\"color\": \"#db2777\", \"width\": 2, \"dash\": \"dot\"}, \"marker\": {\"size\": 7, \"symbol\": \"diamond\"}, \"hovertemplate\": \"N=%{x}<br>%{y:.2f}\\u00d7<extra></extra>\"}],{\"title\": {\"text\": \"Multi-rate scheduler: event-heap (#270) vs stock scan<br><span style='font-size:12px;color:#64748b'>N independent monolith instances on geometrically-spaced intervals</span>\", \"x\": 0.02, \"xanchor\": \"left\", \"font\": {\"size\": 17}}, \"margin\": {\"l\": 70, \"r\": 70, \"t\": 90, \"b\": 110}, \"plot_bgcolor\": \"rgba(0,0,0,0)\", \"paper_bgcolor\": \"rgba(0,0,0,0)\", \"font\": {\"color\": \"#64748b\"}, \"xaxis\": {\"title\": {\"text\": \"number of instances P\"}, \"gridcolor\": \"rgba(148,163,184,0.22)\", \"zeroline\": false, \"type\": \"log\", \"tickvals\": [4, 16, 64, 128, 256], \"ticktext\": [\"4\", \"16\", \"64\", \"128\", \"256\"]}, \"yaxis\": {\"title\": {\"text\": \"run wall-clock (s)\"}, \"gridcolor\": \"rgba(148,163,184,0.22)\", \"zeroline\": false, \"type\": \"log\"}, \"yaxis2\": {\"title\": {\"text\": \"speedup (\\u00d7)\"}, \"overlaying\": \"y\", \"side\": \"right\", \"showgrid\": false, \"rangemode\": \"tozero\", \"zeroline\": false}, \"legend\": {\"orientation\": \"h\", \"x\": 0, \"y\": 1.12, \"xanchor\": \"left\"}, \"annotations\": [{\"xref\": \"paper\", \"yref\": \"paper\", \"x\": 0.97, \"y\": 0.18, \"xanchor\": \"right\", \"showarrow\": false, \"text\": \"<b>1.64\\u00d7</b>\", \"font\": {\"size\": 40, \"color\": \"#db2777\"}}, {\"xref\": \"paper\", \"yref\": \"paper\", \"x\": 0.97, \"y\": 0.04, \"xanchor\": \"right\", \"showarrow\": false, \"text\": \"heap vs scan at N=256\", \"font\": {\"size\": 13}}, {\"xref\": \"paper\", \"yref\": \"paper\", \"x\": 0, \"y\": -0.3, \"xanchor\": \"left\", \"yanchor\": \"top\", \"text\": \"Same math, different tick scheduler &rarr; results bit-identical; only wall-clock differs. Real libroadrunner/CVODE instances: the per-process integration dominates the per-tick scan at small P, so heap is ~5% slower at tiny N (bookkeeping with nothing to gain) and crosses over near P~50-64. The multiplier keeps growing with P (into the hundreds here); #270's cheap-process micro-benchmark is 4.8\\u00d7 at P=100 rising to 46\\u00d7 at P=1000.\", \"showarrow\": false, \"font\": {\"size\": 11, \"color\": \"#64748b\"}}]}, {responsive:true, displayModeBar:false});</script>"}