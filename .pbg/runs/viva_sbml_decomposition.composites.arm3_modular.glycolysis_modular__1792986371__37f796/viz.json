{"convergence_curves": {"html": "<div id=\"viva_ConvergenceCurves\" style=\"width:100%;height:420px\"></div><script src=\"https://cdn.plot.ly/plotly-2.27.0.min.js\"></script><script>Plotly.newPlot(\"viva_ConvergenceCurves\",[{\"type\": \"scatter\", \"mode\": \"lines+markers\", \"x\": [0.0125, 0.1], \"y\": [0.06742701571682175, 0.587], \"name\": \"arm2: Operator split\", \"line\": {\"color\": \"#d97706\", \"width\": 3}, \"marker\": {\"size\": 10}, \"hovertemplate\": \"arm2<br>interval %{x:g}<br>max rel err %{y:.3g}<extra></extra>\"}, {\"type\": \"scatter\", \"mode\": \"lines+markers\", \"x\": [0.0005, 0.002], \"y\": [0.1, 0.468], \"name\": \"arm3: Modular submodels\", \"line\": {\"color\": \"#7c3aed\", \"width\": 3}, \"marker\": {\"size\": 10}, \"hovertemplate\": \"arm3<br>interval %{x:g}<br>max rel err %{y:.3g}<extra></extra>\"}],{\"title\": {\"text\": \"Convergence: smaller coupling interval, smaller error<br><span style='font-size:12px;color:#64748b'>max relative error vs coupling interval, log-log</span>\", \"x\": 0.02, \"xanchor\": \"left\", \"font\": {\"size\": 17}}, \"margin\": {\"l\": 70, \"r\": 25, \"t\": 80, \"b\": 110}, \"plot_bgcolor\": \"rgba(0,0,0,0)\", \"paper_bgcolor\": \"rgba(0,0,0,0)\", \"font\": {\"color\": \"#64748b\"}, \"xaxis\": {\"title\": {\"text\": \"coupling interval\"}, \"gridcolor\": \"rgba(148,163,184,0.22)\", \"zeroline\": false, \"type\": \"log\"}, \"yaxis\": {\"title\": {\"text\": \"max relative error\"}, \"gridcolor\": \"rgba(148,163,184,0.22)\", \"zeroline\": false, \"type\": \"log\"}, \"legend\": {\"orientation\": \"h\", \"y\": 1.02, \"x\": 1, \"xanchor\": \"right\"}, \"annotations\": [{\"xref\": \"paper\", \"yref\": \"paper\", \"x\": 0, \"y\": -0.25, \"xanchor\": \"left\", \"yanchor\": \"top\", \"text\": \"O(P^2) multi-rate scheduler cost in pb<=1.10.x; PR #270 (unmerged 2026-10-25) -> O(P log P). Prefer equal coupling intervals.\", \"showarrow\": false, \"font\": {\"size\": 11, \"color\": \"#64748b\"}}]}, {responsive:true, displayModeBar:false});</script>"}, "overhead_breakdown": {"html": "<div id=\"viva_OverheadBreakdown\" style=\"width:100%;height:420px\"></div><script src=\"https://cdn.plot.ly/plotly-2.27.0.min.js\"></script><script>Plotly.newPlot(\"viva_OverheadBreakdown\",[{\"type\": \"bar\", \"x\": [\"Monolithic<br>Tellurium\", \"Operator<br>split\", \"Native<br>process-bigraph\", \"Coupling<br>demo\"], \"customdata\": [\"arm1\", \"arm2\", \"arm4\", \"arm6\"], \"name\": \"process (compute)\", \"y\": [0.05109440954402089, 0.8373434355016798, 0.3016084067057818, 30.75640798569657], \"marker\": {\"color\": \"#2563eb\"}, \"hovertemplate\": \"%{customdata}<br>process: %{y:.3f} s<extra></extra>\"}, {\"type\": \"bar\", \"x\": [\"Monolithic<br>Tellurium\", \"Operator<br>split\", \"Native<br>process-bigraph\", \"Coupling<br>demo\"], \"customdata\": [\"arm1\", \"arm2\", \"arm4\", \"arm6\"], \"name\": \"framework\", \"y\": [0.024473924422636628, 0.07250889763236046, 0.006255259271711111, 0.4860298892017454], \"marker\": {\"color\": \"#f59e0b\"}, \"hovertemplate\": \"%{customdata}<br>framework: %{y:.3f} s<extra></extra>\"}],{\"title\": {\"text\": \"Where the time goes: process vs framework<br><span style='font-size:12px;color:#64748b'>arms with a measured total (arm3, arm5 not re-timed live); linear seconds, so arm6 dominates</span>\", \"x\": 0.02, \"xanchor\": \"left\", \"font\": {\"size\": 17}}, \"margin\": {\"l\": 70, \"r\": 25, \"t\": 80, \"b\": 110}, \"plot_bgcolor\": \"rgba(0,0,0,0)\", \"paper_bgcolor\": \"rgba(0,0,0,0)\", \"font\": {\"color\": \"#64748b\"}, \"barmode\": \"stack\", \"yaxis\": {\"title\": {\"text\": \"wall-clock (s)\"}, \"gridcolor\": \"rgba(148,163,184,0.22)\", \"zeroline\": false}, \"xaxis\": {\"gridcolor\": \"rgba(0,0,0,0)\"}, \"legend\": {\"orientation\": \"h\", \"y\": 1.02, \"x\": 1, \"xanchor\": \"right\"}, \"annotations\": [{\"x\": \"Monolithic<br>Tellurium\", \"y\": 0.07556833396665752, \"yshift\": 22, \"showarrow\": false, \"text\": \"0.08 s<br>32.4% framework\", \"font\": {\"size\": 11}}, {\"x\": \"Operator<br>split\", \"y\": 0.9098523331340402, \"yshift\": 22, \"showarrow\": false, \"text\": \"0.91 s<br>8.0% framework\", \"font\": {\"size\": 11}}, {\"x\": \"Native<br>process-bigraph\", \"y\": 0.30786366597749293, \"yshift\": 22, \"showarrow\": false, \"text\": \"0.31 s<br>2.0% framework\", \"font\": {\"size\": 11}}, {\"x\": \"Coupling<br>demo\", \"y\": 31.242437874898314, \"yshift\": 22, \"showarrow\": false, \"text\": \"31.24 s<br>1.6% framework\", \"font\": {\"size\": 11}}, {\"xref\": \"paper\", \"yref\": \"paper\", \"x\": 0, \"y\": -0.32, \"xanchor\": \"left\", \"yanchor\": \"top\", \"text\": \"framework SHARE of wall-clock (Composite.timing_summary); highest for the CHEAP monolith, NOT the decomposition cost.\", \"showarrow\": false, \"font\": {\"size\": 11, \"color\": \"#64748b\"}}]}, {responsive:true, displayModeBar:false});</script>"}, "composability_scorecard": {"html": "<div id=\"viva_ComposabilityScorecard\" style=\"width:100%;height:420px\"></div><script src=\"https://cdn.plot.ly/plotly-2.27.0.min.js\"></script><script>Plotly.newPlot(\"viva_ComposabilityScorecard\",[{\"type\": \"heatmap\", \"x\": [\"Monolithic<br>Tellurium\", \"Operator<br>split\", \"Modular<br>submodels\", \"Native<br>process-bigraph\", \"Ensemble<br>(Ray)\", \"Coupling<br>demo\"], \"y\": [\"substitutability\", \"coupling readiness\", \"multiscale fit\"], \"z\": [[0, 1, 2, 2, 2, 3], [0, 1, 2, 2, 2, 3], [0, 1, 2, 3, 2, 3]], \"zmin\": 0, \"zmax\": 3, \"colorscale\": \"Viridis\", \"text\": [[0, 1, 2, 2, 2, 3], [0, 1, 2, 2, 2, 3], [0, 1, 2, 3, 2, 3]], \"texttemplate\": \"%{text}\", \"textfont\": {\"size\": 16, \"color\": \"white\"}, \"xgap\": 3, \"ygap\": 3, \"colorbar\": {\"title\": {\"text\": \"score (0-3)\"}, \"tickvals\": [0, 1, 2, 3]}, \"customdata\": [[\"arm1\", \"arm2\", \"arm3\", \"arm4\", \"arm5\", \"arm6\"], [\"arm1\", \"arm2\", \"arm3\", \"arm4\", \"arm5\", \"arm6\"], [\"arm1\", \"arm2\", \"arm3\", \"arm4\", \"arm5\", \"arm6\"]], \"hovertemplate\": \"%{customdata}<br>%{y}: %{z}/3<extra></extra>\"}],{\"title\": {\"text\": \"Composability scorecard<br><span style='font-size:12px;color:#64748b'>0 = none, 3 = full; rises from the monolith to the cross-engine coupling demo</span>\", \"x\": 0.02, \"xanchor\": \"left\", \"font\": {\"size\": 17}}, \"margin\": {\"l\": 140, \"r\": 25, \"t\": 80, \"b\": 80}, \"plot_bgcolor\": \"rgba(0,0,0,0)\", \"paper_bgcolor\": \"rgba(0,0,0,0)\", \"font\": {\"color\": \"#64748b\"}, \"xaxis\": {\"side\": \"bottom\"}, \"yaxis\": {\"autorange\": \"reversed\"}}, {responsive:true, displayModeBar:false});</script>"}}