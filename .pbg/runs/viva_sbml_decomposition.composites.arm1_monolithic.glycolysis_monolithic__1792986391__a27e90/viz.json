{"ensemble_scaling": {"html": "<div id=\"viva_EnsembleScaling\" style=\"width:100%;height:420px\"></div><script src=\"https://cdn.plot.ly/plotly-2.27.0.min.js\"></script><script>Plotly.newPlot(\"viva_EnsembleScaling\",[{\"type\": \"bar\", \"x\": [\"serial\", \"parallel (ray)\"], \"y\": [1.189, 0.158], \"marker\": {\"color\": [\"#94a3b8\", \"#db2777\"]}, \"text\": [\"1.189 s\", \"0.158 s\"], \"textposition\": \"outside\", \"hovertemplate\": \"%{x}: %{y:.3f} s<extra></extra>\"}],{\"title\": {\"text\": \"Ensemble scaling: Ray beats the GIL<br><span style='font-size:12px;color:#64748b'>8 independent instances, serial vs parallel</span>\", \"x\": 0.02, \"xanchor\": \"left\", \"font\": {\"size\": 17}}, \"margin\": {\"l\": 70, \"r\": 25, \"t\": 80, \"b\": 100}, \"plot_bgcolor\": \"rgba(0,0,0,0)\", \"paper_bgcolor\": \"rgba(0,0,0,0)\", \"font\": {\"color\": \"#64748b\"}, \"yaxis\": {\"title\": {\"text\": \"wall-clock (s)\"}, \"gridcolor\": \"rgba(148,163,184,0.22)\", \"zeroline\": false, \"range\": [0, 1.4268]}, \"xaxis\": {\"gridcolor\": \"rgba(0,0,0,0)\"}, \"showlegend\": false, \"annotations\": [{\"xref\": \"paper\", \"yref\": \"paper\", \"x\": 0.97, \"y\": 0.9, \"xanchor\": \"right\", \"showarrow\": false, \"text\": \"<b>7.52x</b>\", \"font\": {\"size\": 44, \"color\": \"#db2777\"}}, {\"xref\": \"paper\", \"yref\": \"paper\", \"x\": 0.97, \"y\": 0.78, \"xanchor\": \"right\", \"showarrow\": false, \"text\": \"on 16 cores, 8 instances\", \"font\": {\"size\": 13}}, {\"xref\": \"paper\", \"yref\": \"paper\", \"x\": 0, \"y\": -0.2, \"xanchor\": \"left\", \"yanchor\": \"top\", \"text\": \"GIL note: libroadrunner does not release the GIL; ThreadPool(8)=0.99x\", \"showarrow\": false, \"font\": {\"size\": 11, \"color\": \"#64748b\"}}]}, {responsive:true, displayModeBar:false});</script>"}, "runtime_comparison": {"html": "<div id=\"viva_RuntimeComparison\" style=\"width:100%;height:420px\"></div><script src=\"https://cdn.plot.ly/plotly-2.27.0.min.js\"></script><script>Plotly.newPlot(\"viva_RuntimeComparison\",[{\"type\": \"bar\", \"x\": [\"Monolithic<br>Tellurium\", \"Operator<br>split\", \"Modular<br>submodels\", \"Native<br>process-bigraph\", \"Ensemble<br>(Ray)\", \"Coupling<br>demo\"], \"y\": [0.3238648139766464, 0.07969303917988457, 0.05, 0.02031827709142012, null, 0.015556720994306444], \"text\": [\"32.4%<br>0.08 s total\", \"8.0%<br>0.91 s total\", \"5.0%<br>total n/a\", \"2.0%<br>0.31 s total\", \"not recorded\", \"1.6%<br>31.24 s total\"], \"textposition\": \"outside\", \"cliponaxis\": false, \"marker\": {\"color\": [\"#2563eb\", \"#d97706\", \"#7c3aed\", \"#059669\", \"#db2777\", \"#0891b2\"]}, \"customdata\": [\"arm1\", \"arm2\", \"arm3\", \"arm4\", \"arm5\", \"arm6\"], \"hovertemplate\": \"%{customdata}<br>framework share: %{y:.1%}<extra></extra>\"}],{\"title\": {\"text\": \"Framework overhead share by arm<br><span style='font-size:12px;color:#64748b'>share of wall-clock spent in the framework (not process compute)</span>\", \"x\": 0.02, \"xanchor\": \"left\", \"font\": {\"size\": 17}}, \"margin\": {\"l\": 70, \"r\": 25, \"t\": 80, \"b\": 110}, \"plot_bgcolor\": \"rgba(0,0,0,0)\", \"paper_bgcolor\": \"rgba(0,0,0,0)\", \"font\": {\"color\": \"#64748b\"}, \"yaxis\": {\"title\": {\"text\": \"overhead fraction\"}, \"gridcolor\": \"rgba(148,163,184,0.22)\", \"zeroline\": false, \"tickformat\": \".0%\", \"range\": [0, 0.42102425816964034]}, \"xaxis\": {\"gridcolor\": \"rgba(0,0,0,0)\"}, \"showlegend\": false, \"annotations\": [{\"xref\": \"paper\", \"yref\": \"paper\", \"x\": 0, \"y\": -0.3, \"xanchor\": \"left\", \"yanchor\": \"top\", \"text\": \"framework SHARE of wall-clock (Composite.timing_summary); highest for the CHEAP monolith, NOT the decomposition cost.\", \"showarrow\": false, \"font\": {\"size\": 11, \"color\": \"#64748b\"}}]}, {responsive:true, displayModeBar:false});</script>"}}