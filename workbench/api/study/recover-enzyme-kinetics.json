{"schema_version": 4, "name": "recover-enzyme-kinetics", "investigation": "discovery-sbml-recovery", "status": "ran", "title": "Recover enzyme kinetics (Michaelis-Menten)", "confidence": "Planned", "question": "From synthetic data generated by a known enzyme-kinetics model, can the cycle\nrecover a flat SBML \u2014 and does it recover the elementary mechanism\n(E + S <-> ES -> E + P) or the reduced Michaelis-Menten rate law, and which is\nthe parsimonious answer the data actually support?\n", "hypothesis": "Both the elementary mechanism and the reduced saturating law fit the observed\nproduct/substrate trajectories. The cycle recovers the trajectory out of the box,\nbut choosing the right structural form requires a rate-law-fitter and a parsimony\nevaluator: with only substrate/product observed, the reduced MM law is the\nparsimonious recovery; the elementary steps are only warranted if ES is observed.\n", "objective": "Recover a flat SBML for Michaelis-Menten kinetics from synthetic targets and\ndetermine, via structural scoring + parsimony, which rate-law form the data\njustify.\n", "description": "Second rung. Ground truth is a Michaelis-Menten enzyme model; the synthetic\ntarget exposes substrate and product trajectories (ES optionally hidden). This\nrung forces a real modelling choice \u2014 elementary vs reduced rate law \u2014 so it is\nwhere the loop first needs to propose a non-mass-action (saturating) rate law and\nfit its parameters (Km, Vmax). The parsimony evaluator decides between the forms\ngiven what is observed. Builds on the scoring calibrated in recover-mass-action.\n", "parent_studies": [{"study": "recover-mass-action", "relation": "builds-on"}], "baseline": [{"name": "baseline", "composite": "viva_sbml_decomposition.composites.recovery.recover_candidate", "params": {"target": "recover-enzyme-kinetics"}}], "variants": [], "interventions": [], "expected_behavior": [{"name": "enzyme-trajectory-recovered", "observable": "recovered-model simulation vs synthetic target (substrate + product, shared grid)", "condition": "normalized RMSE < 0.05 on observed species", "rationale": "the recovered kinetics must reproduce the observed substrate depletion and product formation."}, {"name": "enzyme-structure-recovered", "observable": "recovered rate law + parameters vs ground truth (Km, Vmax or elementary k's)", "condition": "the recovered form is consistent with ground truth and its parameters are within 10% (Km, Vmax)", "rationale": "recovery means capturing the enzyme's actual kinetic law, not an arbitrary curve that happens to fit."}, {"name": "enzyme-parsimonious", "observable": "form chosen (reduced MM vs elementary steps) vs what the observed species justify", "condition": "the loop selects the minimal form the data support (reduced MM when ES is unobserved), with no unsupported elementary steps", "rationale": "with partial observation, parsimony is the correct arbiter between observationally-equivalent mechanisms."}], "readouts": [{"name": "S", "description": "Species S trajectory from the candidate run.", "identifier": "S", "units": "concentration"}, {"name": "E", "description": "Species E trajectory from the candidate run.", "identifier": "E", "units": "concentration"}, {"name": "ES", "description": "Species ES trajectory from the candidate run.", "identifier": "ES", "units": "concentration"}, {"name": "P", "description": "Species P trajectory from the candidate run.", "identifier": "P", "units": "concentration"}], "behavior_tests": [{"name": "enzyme-trajectory-recovered", "classification": "accuracy", "measure": {"kind": "recovery_trajectory", "target": "recover-enzyme-kinetics", "tol": 0.05}, "pass_if": {"op": "threshold", "detail": "graded by viva_sbml_decomposition.evaluators (recovery_trajectory)"}, "requires_simulation": true, "description": "Graded by the recovery capabilities (recovery_trajectory)."}, {"name": "enzyme-structure-recovered", "classification": "correctness", "measure": {"kind": "recovery_st