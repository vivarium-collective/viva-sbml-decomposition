{"schema_version": 4, "name": "recover-gene-switch", "investigation": "discovery-sbml-recovery", "status": "ran", "title": "Recover a Hill gene switch", "confidence": "Planned", "question": "From synthetic data of a bistable Hill-repression gene switch, can the cycle\nrecover a flat SBML that reproduces both stable branches and the nonlinear\n(Hill) regulation \u2014 a case where the data alone underdetermine the mechanism?\n", "hypothesis": "Genuine nonlinearity and bistability mean a one-shot fit is insufficient: the\ncycle's frontier (what the current candidate fails to explain \u2014 e.g. the second\nstable branch or the switch sharpness) must drive the search. The loop recovers\nthe Hill term (coefficient and threshold) and reproduces bistability only once\nreaction-proposal + rate-law-fitting capabilities handle the nonlinear regulation.\n", "objective": "Recover a flat SBML for a bistable Hill switch from synthetic targets spanning\nboth stable states, and verify the recovered model reproduces the switch\nqualitatively, not just a single trajectory.\n", "description": "Third rung \u2014 the first with genuine nonlinearity and multistability. Ground truth\nis a Hill-repression switch with two stable steady states; synthetic targets\ninclude trajectories from initial conditions in both basins. The data\nunderdetermine the mechanism, so this rung stresses frontier-driven refinement:\nthe discovery cycle must use the residual (unexplained branch / sharpness) to\npropose the Hill nonlinearity rather than fit a linear surrogate. Exercises the\nreaction-proposer and rate-law-fitter on a non-mass-action regulatory term.\n", "parent_studies": [{"study": "recover-enzyme-kinetics", "relation": "builds-on"}], "baseline": [{"name": "baseline", "composite": "viva_sbml_decomposition.composites.recovery.recover_candidate", "params": {"target": "recover-gene-switch"}}], "variants": [], "interventions": [], "expected_behavior": [{"name": "gene-switch-trajectory-recovered", "observable": "recovered-model simulation vs synthetic targets from both basins (shared grid)", "condition": "normalized RMSE < 0.05 on observed species for trajectories in both stable branches", "rationale": "a recovery that fits only one branch has missed the bistability that defines the system."}, {"name": "gene-switch-structure-recovered", "observable": "recovered regulatory term vs ground truth (Hill coefficient n, threshold K)", "condition": "a Hill (or equivalently nonlinear) repression term is recovered with n and K within 15% of truth", "rationale": "the switch behavior comes from the nonlinear term; recovering it is what distinguishes mechanism from curve-fit."}, {"name": "gene-switch-bistability-reproduced", "observable": "steady states of the recovered model across initial conditions", "condition": "the recovered model exhibits two stable steady states matching the ground-truth switch (qualitative)", "rationale": "reproducing the qualitative bistable structure is the real test, beyond point-wise trajectory fit."}], "readouts": [{"name": "u", "description": "Species u trajectory from the candidate run.", "identifier": "u", "units": "concentration"}, {"name": "v", "description": "Species v trajectory from the candidate run.", "identifier": "v", "units": "concentration"}], "behavior_tests": [{"name": "gene-switch-trajectory-recovered", "classification": "accuracy", "measure": {"kind": "recovery_trajectory", "target": "recover-gene-switch", "tol": 0.05}, "pass_if": {"op": "threshold", "detail": "graded by viva_sbml_decomposition.evaluators (recovery_trajectory)"}, "requires_simulation": true, "description": "Graded by the recovery capabilities (recovery_trajectory)."}, {"name": "gene-switch-structure-recovered", "classification": "correctness", "measure": {"kind": "recovery_structure", "target": "recover-gene-switch", "param_tol": 0.15}, "pass_if": {"op": "threshold", "detail": "graded by viva_sbml_decomposition.evaluators (recovery_structure)"}, "requires_simu